{
  "name": "couch-party",
  "version": "1.0.0",
  "private": true,
  "description": "Kogiel Mogiel Couch Party – Jackbox-style party games: one TV, phones as controllers.",
  "type": "module",
  "scripts": {
    "dev": "vite build && concurrently -k -n vite,wrangler -c yellow,magenta \"vite build --watch --emptyOutDir false --logLevel warn\" \"wrangler dev\"",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "preact": "^10.29.8",
    "three": "^0.180.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@types/three": "^0.180.0",
    "concurrently": "^9.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "wrangler": "^4.147.0"
  }
}
